<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.DriveNext.Toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/profile_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- На планшетах содержимое не растягивается шире 480dp -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="480dp">

                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:contentDescription="@string/profile_avatar_description">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:background="@color/avatar_background"
                        android:importantForAccessibility="no"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_avatar_placeholder"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.DriveNext.Circle"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:importantForAccessibility="no"
                        android:src="@drawable/bg_avatar_badge" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="24dp"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Иван Иванов" />

                <TextView
                    android:id="@+id/tvJoined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="Присоединился в июле 2024" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp">

                    <TextView
                        style="@style/Widget.DriveNext.ProfileLabel"
                        android:text="@string/field_email" />

                    <TextView
                        android:id="@+id/tvEmail"
                        style="@style/Widget.DriveNext.ProfileValue"
                        tools:text="ivanov@mtuci.ru" />
                </LinearLayout>

                <View style="@style/Widget.DriveNext.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp">

                    <TextView
                        style="@style/Widget.DriveNext.ProfileLabel"
                        android:text="@string/field_password" />

                    <TextView
                        android:id="@+id/tvChangePassword"
                        style="@style/Widget.DriveNext.ProfileValue"
                        android:layout_width="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="2dp"
                        android:text="@string/profile_password_change"
                        android:textColor="@color/primary" />
                </LinearLayout>

                <View style="@style/Widget.DriveNext.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp">

                    <TextView
                        style="@style/Widget.DriveNext.ProfileLabel"
                        android:text="@string/field_gender" />

                    <TextView
                        android:id="@+id/tvGender"
                        style="@style/Widget.DriveNext.ProfileValue"
                        tools:text="Мужской" />
                </LinearLayout>

                <View style="@style/Widget.DriveNext.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp">

                    <TextView
                        style="@style/Widget.DriveNext.ProfileLabel"
                        android:text="@string/profile_google" />

                    <TextView
                        android:id="@+id/tvGoogle"
                        style="@style/Widget.DriveNext.ProfileValue"
                        tools:text="ivanov@gmail.com" />
                </LinearLayout>

                <View style="@style/Widget.DriveNext.Divider" />

                <TextView
                    android:id="@+id/tvSignOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:minHeight="52dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp"
                    android:text="@string/profile_sign_out"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Индикатор загрузки профиля и сохранения аватара; перехватывает нажатия, пока идёт запрос -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/loading_scrim"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/primary" />

        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/profile_saving"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
