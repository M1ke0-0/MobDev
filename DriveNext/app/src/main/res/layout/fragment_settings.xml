<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.DriveNext.Toolbar"
        app:navigationIcon="@null"
        app:title="@string/settings_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Профиль пользователя: по нажатию — экран «Профиль» -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profileRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/settings_open_profile"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@color/avatar_background"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_avatar_placeholder"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DriveNext.Circle" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/tvEmail"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron"
                    app:layout_constraintStart_toEndOf="@id/ivAvatar"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:text="Иван Иванов" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/tvName"
                    app:layout_constraintStart_toStartOf="@id/tvName"
                    app:layout_constraintTop_toBottomOf="@id/tvName"
                    tools:text="ivan@mtuci.ru" />

                <!-- Пока профиль грузится с сервера, вместо имени крутится индикатор -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/profileProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/primary"
                    app:indicatorSize="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivAvatar"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/rowBookings"
                style="@style/Widget.DriveNext.SettingsRow"
                android:layout_marginTop="8dp"
                android:text="@string/settings_my_bookings"
                app:drawableStartCompat="@drawable/ic_bookings" />

            <TextView
                android:id="@+id/rowTheme"
                style="@style/Widget.DriveNext.SettingsRow"
                android:layout_marginTop="8dp"
                android:text="@string/settings_theme"
                app:drawableStartCompat="@drawable/ic_theme" />

            <TextView
                android:id="@+id/rowNotifications"
                style="@style/Widget.DriveNext.SettingsRow"
                android:text="@string/settings_notifications"
                app:drawableStartCompat="@drawable/ic_notifications" />

            <TextView
                android:id="@+id/rowAddCar"
                style="@style/Widget.DriveNext.SettingsRow"
                android:text="@string/settings_add_car"
                app:drawableStartCompat="@drawable/ic_add_car" />

            <View
                style="@style/Widget.DriveNext.Divider"
                android:layout_marginHorizontal="24dp"
                android:layout_marginVertical="4dp" />

            <TextView
                android:id="@+id/rowHelp"
                style="@style/Widget.DriveNext.SettingsRow"
                android:text="@string/settings_help"
                app:drawableStartCompat="@drawable/ic_help" />

            <TextView
                android:id="@+id/rowInvite"
                style="@style/Widget.DriveNext.SettingsRow"
                android:text="@string/settings_invite"
                app:drawableStartCompat="@drawable/ic_invite" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
