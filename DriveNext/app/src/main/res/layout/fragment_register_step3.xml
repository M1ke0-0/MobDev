<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <!-- На широких экранах форма не растягивается шире 480dp -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="480dp">

                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:contentDescription="@string/register_avatar_description">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@color/avatar_background"
                        android:importantForAccessibility="no"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_avatar_placeholder"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.DriveNext.Circle" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:importantForAccessibility="no"
                        android:src="@drawable/bg_avatar_badge" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/register_avatar_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Widget.DriveNext.FieldLabel"
                    android:text="@string/field_license_number" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLicenseNumber"
                    style="@style/Widget.DriveNext.TextField">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLicenseNumber"
                        style="@style/Widget.DriveNext.TextField.Input"
                        android:hint="@string/field_license_number_hint"
                        android:inputType="number"
                        android:maxLength="10" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.DriveNext.FieldLabel"
                    android:text="@string/field_issue_date" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilIssueDate"
                    style="@style/Widget.DriveNext.TextField"
                    app:startIconContentDescription="@string/open_calendar"
                    app:startIconDrawable="@drawable/ic_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etIssueDate"
                        style="@style/Widget.DriveNext.TextField.Input"
                        android:hint="@string/field_date_hint"
                        android:inputType="date"
                        android:digits="0123456789/"
                        android:maxLength="10" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.DriveNext.FieldLabel"
                    android:text="@string/field_license_photo" />

                <LinearLayout
                    android:id="@+id/licensePhotoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivLicensePhoto"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_upload_box"
                        android:contentDescription="@string/upload_photo"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_upload"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.DriveNext.Rounded8" />

                    <TextView
                        android:id="@+id/tvLicensePhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/upload_photo"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.DriveNext.FieldLabel"
                    android:text="@string/field_passport_photo" />

                <LinearLayout
                    android:id="@+id/passportPhotoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivPassportPhoto"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_upload_box"
                        android:contentDescription="@string/upload_photo"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_upload"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.DriveNext.Rounded8" />

                    <TextView
                        android:id="@+id/tvPassportPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/upload_photo"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        style="@style/Widget.DriveNext.PrimaryButton"
        android:layout_width="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="@string/register_next"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="480dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

