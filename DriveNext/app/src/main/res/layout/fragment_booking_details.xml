<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.DriveNext.Toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="invisible">

            <include
                android:id="@+id/carCard"
                layout="@layout/view_booking_car" />

            <include
                android:id="@+id/rowAddress"
                layout="@layout/view_info_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <include
                android:id="@+id/rowStart"
                layout="@layout/view_info_row" />

            <include
                android:id="@+id/rowEnd"
                layout="@layout/view_info_row" />

            <include
                android:id="@+id/rowDriver"
                layout="@layout/view_info_row" />

            <include
                android:id="@+id/rowLicense"
                layout="@layout/view_info_row" />

            <include
                android:id="@+id/rowStatus"
                layout="@layout/view_info_row" />

            <View
                style="@style/Widget.DriveNext.Divider"
                android:layout_marginVertical="12dp" />

            <include
                android:id="@+id/rowRent"
                layout="@layout/view_info_row" />

            <include
                android:id="@+id/rowInsurance"
                layout="@layout/view_info_row" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/booking_details_total"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.DriveNext.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_margin="16dp"
        android:text="@string/booking_cancel"
        android:visibility="gone" />

</LinearLayout>
