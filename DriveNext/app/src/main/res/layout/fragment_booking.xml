<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.DriveNext.Toolbar"
        app:title="@string/booking_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <include
                android:id="@+id/carCard"
                layout="@layout/view_booking_car" />

            <!-- Даты: нажатие на любую строку открывает выбор периода аренды -->
            <LinearLayout
                android:id="@+id/datesBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/booking_pick_dates"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowStart"
                    layout="@layout/view_info_row" />

                <include
                    android:id="@+id/rowEnd"
                    layout="@layout/view_info_row" />
            </LinearLayout>

            <View
                style="@style/Widget.DriveNext.Divider"
                android:layout_marginVertical="12dp" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_location"
                tools:text="Авиамоторная ул., 8, стр. 2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:text="@string/details_address"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <View
                style="@style/Widget.DriveNext.Divider"
                android:layout_marginVertical="12dp" />

            <include
                android:id="@+id/rowRent"
                layout="@layout/view_info_row" />

            <include
                android:id="@+id/rowInsurance"
                layout="@layout/view_info_row" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_field"
                android:backgroundTint="@color/search_header"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <include
                    android:id="@+id/rowTotal"
                    layout="@layout/view_info_row" />

                <include
                    android:id="@+id/rowDeposit"
                    layout="@layout/view_info_row" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        style="@style/Widget.DriveNext.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_margin="16dp"
        android:text="@string/booking_continue" />

</LinearLayout>
